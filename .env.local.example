# LLM Gateway - 本地 Docker Compose 环境变量
# cp .env.local.example .env.local 后按需修改
# 大多数值在 docker-compose.local.yml 中有默认值，不创建此文件也可直接启动
#
# 启动命令:
#   docker compose -f docker-compose.local.yml --env-file .env.local up --build -d

# ── 网关安全 ──
AUTH_TOKEN=sk-your-local-token
ADMIN_TOKEN=your-local-admin-token
JWT_SECRET=change-me-in-production
ADMIN_INIT_TOKEN=your-init-token

# ── 数据库（Docker 内部 PostgreSQL 容器）──
POSTGRES_PASSWORD=change-me

# ── 短信（可选，留空则短信功能不可用）──
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_ACCOUNT=
SMS_TPL_LOGIN=
SMS_TPL_REGISTER=
SMS_TPL_RESET=
SMS_TPL_ALERT=

# ── 支付宝（可选，留空则支付功能不可用）──
ALIPAY_APP_ID=
ALIPAY_NOTIFY_URL=http://localhost:3000/api/payment/alipay/notify
ALIPAY_RETURN_URL=http://localhost:3000/balance
ALIPAY_IS_PRODUCTION=false
