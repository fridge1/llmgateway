# LLM Gateway 环境变量配置
# cp .env.example .env 后填入实际值
# LLM API Key 和 Base URL 已完全由数据库管理，通过 Admin 后台配置

# ── 网关安全 ──
AUTH_TOKEN=sk-your-gateway-token
ADMIN_TOKEN=your-admin-token
JWT_SECRET=change-me-in-production
ADMIN_INIT_TOKEN=your-admin-init-token  # Required for first-user admin registration

# ── 数据库 ──
POSTGRES_PASSWORD=change-me
DB_HOST=your-db-host

# ── 短信 (火山引擎) ──
SMS_ACCESS_KEY=your-sms-access-key
SMS_SECRET_KEY=your-sms-secret-key
SMS_SIGN_NAME=your-sign-name
SMS_ACCOUNT=your-sms-account
SMS_TPL_LOGIN=your-login-template-id
SMS_TPL_REGISTER=your-register-template-id
SMS_TPL_RESET=your-reset-template-id
SMS_TPL_ALERT=your-alert-template-id

# ── 邮件 (阿里云邮件推送) ──
EMAIL_ACCESS_KEY=your-email-access-key
EMAIL_SECRET_KEY=your-email-secret-key
EMAIL_REGION=cn-hangzhou
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=LLM Gateway
EMAIL_TPL_REGISTER=your-register-template-id
EMAIL_TPL_RESET=your-reset-template-id

# ── 支付宝 ──
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_NOTIFY_URL=https://your-domain.com/api/payment/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.com/balance
ALIPAY_IS_PRODUCTION=false

# ── 对象存储 TOS (火山引擎) ──
TOS_ACCESS_KEY=your-tos-access-key
TOS_SECRET_KEY=your-tos-secret-key
TOS_BUCKET=your-tos-bucket
TOS_URL_PREFIX=https://your-bucket.tos-cn-beijing.volces.com

# ── 图片生成 ──
# 全局上游图片生成/编辑并发上限（单任务内最多 4 路并发，跨任务由该值统一闸控）
IMAGE_UPSTREAM_MAX_CONCURRENCY=32
